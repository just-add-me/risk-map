# Скопируйте в .env и заполните (скрипт deploy/install.sh делает это сам).

# Адрес сайта. Без домена: <IP через дефисы>.sslip.io, например 203-0-113-5.sslip.io
DOMAIN=203-0-113-5.sslip.io
COOKIE_SECURE=1

# Вход в панель
ADMIN_USER=admin
ADMIN_PASSWORD=придумайте-длинный-пароль
SECRET_KEY=

# AIS: ключ с https://aisstream.io (раздел API Keys). Пусто — работает демо-симулятор.
AISSTREAM_API_KEY=
# demo | aisstream (если не указано — выбирается по наличию ключа)
AIS_MODE=

# Алерты
WARN_DISTANCE_NM=50
STALE_AIS_HOURS=24

# Как часто проверять сайт LMA на новый циркуляр (часов). 12 = два раза в сутки.
CIRCULAR_CHECK_HOURS=12
