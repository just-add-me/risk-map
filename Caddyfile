# Caddy сам получает и продлевает HTTPS-сертификат для адреса из переменной DOMAIN.
# Без своего домена подойдёт адрес вида 203-0-113-5.sslip.io (указывает на IP 203.0.113.5).
{$DOMAIN} {
	# Пускаем только адреса из ALLOWED_IPS (.env), остальным сразу рвём соединение
	@blocked not remote_ip {$ALLOWED_IPS}
	abort @blocked

	# больше 30 МБ не принимаем: защита от огромных запросов (в том числе на страницу входа без пароля);
	# самые большие законные — PDF циркуляра и файл флота, они на порядок меньше
	request_body {
		max_size 30MB
	}

	encode gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
